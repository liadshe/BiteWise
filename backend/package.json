{
  "name": "bitewise-backend",
  "version": "1.0.0",
  "description": "Web Development course final project - backend",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsc && node --env-file=.env.prod ./dist/server.js",
    "dev": "nodemon --exec \"node --env-file=.env.dev -r ts-node/register\" src/server.ts",
    "test": "tsc && jest --detectOpenHandles --forceExit --runInBand",
    "testPost": "tsc && jest --detectOpenHandles --forceExit --runInBand --coverage ./src/tests/post.test.ts",
    "testComment": "tsc && jest --detectOpenHandles --forceExit --runInBand ./src/tests/comment.test.ts",
    "testAuth": "tsc && jest --detectOpenHandles --forceExit --runInBand ./src/tests/auth.test.ts",
    "testUser": "tsc && jest --detectOpenHandles --forceExit --runInBand ./src/tests/user.test.ts",
    "test:coverage": "tsc && jest --detectOpenHandles --forceExit --runInBand --coverage",
    "prod1": "tsc -p tsconfig_prod.json && node --env-file=.env.prod ./dist/server.js",
    "prod": "tsc -p tsconfig_prod.json && pm2 restart ecosystem.config.js --env production --env-file .env.prod"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liadshe/BiteWise.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/liadshe/BiteWise-backend/issues"
  },
  "homepage": "https://github.com/liadshe/BiteWise-backend#readme",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.13.5",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.19.4",
    "multer": "^2.1.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "bcrypt": "^6.0.0",
    "google-auth-library": "^8.7.0"
    },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.3",
    "globals": "^17.3.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0",
    "@types/bcrypt": "^6.0.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/multer": "^2.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/express": "^5.0.6",
    "@types/cors": "^2.8.19"
  }
}
